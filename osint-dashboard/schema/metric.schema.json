{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactical metric",
  "description": "One dated, sourced number about how a tactic performs. Metric keys are checked against taxonomy.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "metric", "date", "date_precision", "value", "value_low", "value_high", "side", "scope", "source_org", "source_title", "source_url", "access", "confidence", "note"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "metric": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "date_precision": {"enum": ["day", "month", "quarter", "year"]},
    "value": {"type": "number"},
    "value_low": {"type": ["number", "null"]},
    "value_high": {"type": ["number", "null"]},
    "side": {"enum": ["RU", "UA", "both"]},
    "scope": {"type": "string", "description": "Where or what the number covers, e.g. 'Kyiv region' or 'one pilot'"},
    "source_org": {"enum": ["ISW", "RUSI", "Media", "Other think tank", "UA MoD", "Official"]},
    "source_title": {"type": "string", "minLength": 3},
    "source_url": {"type": "string", "pattern": "^https://"},
    "access": {"enum": ["primary", "secondary"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "note": {"type": "string", "maxLength": 280}
  }
}
